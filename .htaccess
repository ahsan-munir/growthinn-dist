# ═══════════════════════════════════════════════════════════════════
# .htaccess — GENERATED by scripts/build-htaccess.mjs
#
# ⛔ DO NOT EDIT. Overwritten on every build.
#    The rules live in public/_redirects — edit there, then rebuild.
#
# For Apache hosts (Hostinger, cPanel, most shared hosting), which
# do NOT read _redirects or _headers. Those files stay in dist/ for
# Netlify / Cloudflare Pages; the three coexist harmlessly because
# each host ignores the others' format.
# ═══════════════════════════════════════════════════════════════════

# ── The redirect map · [W1] · 20 rules ──────────────────────
# ⛔ 301 permanent. No chains: every source points at its final target.
<IfModule mod_alias.c>
  RedirectMatch 301 "^/process/$" "/standard/"
  RedirectMatch 301 "^/case-studies/$" "/work/"
  RedirectMatch 301 "^/insights/$" "/notes/"
  RedirectMatch 301 "^/case-studies/beauty-headless-migration/$" "/work/"
  RedirectMatch 301 "^/case-studies/fitness-technical-seo/$" "/work/"
  RedirectMatch 301 "^/case-studies/haircare-theme-rebuild/$" "/work/"
  RedirectMatch 301 "^/case-studies/supplement-brand-cro/$" "/work/"
  RedirectMatch 301 "^/case-studies/wellness-pdp-cro/$" "/work/"
  RedirectMatch 301 "^/ecommerce-development-services/$" "/services/"
  RedirectMatch 301 "^/ecommerce-development-services/conversion-theme-development/$" "/services/theme-development/"
  RedirectMatch 301 "^/ecommerce-development-services/shopify-technical-seo/$" "/services/technical-seo/"
  RedirectMatch 301 "^/ecommerce-development-services/shopify-landing-page-development/$" "/services/landing-pages/"
  RedirectMatch 301 "^/ecommerce-development-services/shopify-cro/$" "/services/cro-ux/"
  RedirectMatch 301 "^/ecommerce-development-services/shopify-product-page-development/$" "/services/cro-ux/"
  RedirectMatch 301 "^/ecommerce-development-services/ecommerce-cro-audit/$" "/audit/"
  RedirectMatch 301 "^/insights/conversion-theme-architecture/$" "/notes/conversion-theme-architecture/"
  RedirectMatch 301 "^/insights/cro-consultant-vs-agency/$" "/notes/cro-consultant-vs-agency/"
  RedirectMatch 301 "^/insights/shopify-cro-mistakes/$" "/notes/shopify-cro-mistakes/"
  RedirectMatch 301 "^/insights/shopify-technical-seo-guide/$" "/notes/shopify-technical-seo-guide/"
  RedirectMatch 301 "^/insights/shopify-traffic-no-sales/$" "/notes/shopify-traffic-no-sales/"
</IfModule>

# ── Short links · src/data/links.ts · 3 codes ────────────────
# ⛔ GENERATED. Add or change a link in src/data/links.ts, then rebuild.
#    A hand-edit here survives until the next `pnpm release` and then
#    disappears with no error.
#
# ⛔ 302, not 301 — these handles are EXPECTED to be re-pointed. A 301
#    is cached hard by browsers and CDNs, so a later re-point reaches
#    some readers and not others, with no way to tell which.
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Evergreen. The published standard — the on-sight signal [OS-1].
  RewriteRule "^go/standards/?$" "/standard/?utm_source=linkedin&utm_medium=social&utm_campaign=shopify_standards" [R=302,L,QSD]
  # Evergreen. The paid audit, the merchant sink [F6].
  RewriteRule "^go/theme-audit/?$" "/audit/?utm_source=linkedin&utm_medium=social&utm_campaign=theme_audit" [R=302,L,QSD]
  # Evergreen. The agency sink [F6] — the other peer, not a fallback.
  RewriteRule "^go/agencies/?$" "/for-agencies/?utm_source=linkedin&utm_medium=social&utm_campaign=agency_standard" [R=302,L,QSD]
</IfModule>

# ── Trailing slashes ───────────────────────────────────────────────
# astro.config.mjs sets `trailingSlash: "always"` and the build emits
# directory-style pages (/about/index.html). This makes Apache agree,
# so /about and /about/ do not become two URLs with the same content.
#
# ⚠️ The redirect rules above run FIRST (mod_alias precedes mod_rewrite),
# so an old URL is 301'd to its target before this can touch it.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Never rewrite a real file or directory.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Add the trailing slash to anything else that lacks one.
  RewriteCond %{REQUEST_URI} !(/$|\.[a-zA-Z0-9]{2,5}$)
  RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

# ── Caching — mirrors public/_headers ──────────────────────────────
<IfModule mod_headers.c>
  # Fonts are content-addressed by name; a new face means a new file.
  <FilesMatch "\.(woff2|woff|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>

  # Astro fingerprints everything in /_astro/.
  <FilesMatch "\.(css|js|webp|avif|png|jpg|jpeg|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # ⚠️ HTML MUST REVALIDATE. /standard/ renders readings measured at
  # build time, and a cached page shows yesterday's numbers as today's.
  <FilesMatch "\.(html|xml|txt|json)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── The 404 ────────────────────────────────────────────────────────
# ⛔ A real 404, not a redirect to /. A blanket redirect to root is read
# as a soft 404 and is worse than a clean one. [W1 §2]
ErrorDocument 404 /404.html

# ── Compression ────────────────────────────────────────────────────
# The stylesheet is inlined into every document, so HTML is the largest
# thing on the wire. [SD-20]'s floor cares.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
