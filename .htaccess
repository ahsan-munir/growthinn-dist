# ═══════════════════════════════════════════════════════════════════
# .htaccess — GENERATED by scripts/build-htaccess.mjs
#
# ⛔ DO NOT EDIT. Overwritten on every build.
#    The rules live in public/_redirects — edit there, then rebuild.
#
# For Apache hosts (Hostinger, cPanel, most shared hosting), which
# do NOT read _redirects or _headers. Those files stay in dist/ for
# Netlify / Cloudflare Pages; the three coexist harmlessly because
# each host ignores the others' format.
# ═══════════════════════════════════════════════════════════════════

# ── The redirect map · 26 rules ───────────────────────────
# ⛔ 301 permanent. No chains: every source points at its final target.
# ⚠️ Three site generations collapse here — gen-1 /ecommerce-development-
#    services/*, gen-2 /services/*, and the gen-3 renames.
<IfModule mod_alias.c>
  RedirectMatch 301 "^/ecommerce-development-services/$" "/services/"
  RedirectMatch 301 "^/ecommerce-development-services/shopify-cro/$" "/shopify-cro/"
  RedirectMatch 301 "^/ecommerce-development-services/shopify-technical-seo/$" "/shopify-technical-seo/"
  RedirectMatch 301 "^/ecommerce-development-services/ecommerce-cro-audit/$" "/shopify-cro-audit/"
  RedirectMatch 301 "^/ecommerce-development-services/conversion-theme-development/$" "/shopify-theme-redesign/"
  RedirectMatch 301 "^/ecommerce-development-services/shopify-landing-page-development/$" "/landing-pages-paid-traffic/"
  RedirectMatch 301 "^/ecommerce-development-services/shopify-product-page-development/$" "/shopify-cro/"
  RedirectMatch 301 "^/services/cro-ux/$" "/shopify-cro/"
  RedirectMatch 301 "^/services/technical-seo/$" "/shopify-technical-seo/"
  RedirectMatch 301 "^/services/theme-development/$" "/shopify-theme-redesign/"
  RedirectMatch 301 "^/services/theme-redesign/$" "/shopify-theme-redesign/"
  RedirectMatch 301 "^/services/landing-pages/$" "/landing-pages-paid-traffic/"
  RedirectMatch 301 "^/services/performance/$" "/shopify-cro/"
  RedirectMatch 301 "^/what-i-do/$" "/services/"
  RedirectMatch 301 "^/results/$" "/case-studies/"
  RedirectMatch 301 "^/audit/$" "/shopify-cro-audit/"
  RedirectMatch 301 "^/amazon/$" "/amazon-to-shopify/"
  RedirectMatch 301 "^/standard/$" "/method/"
  RedirectMatch 301 "^/work/$" "/case-studies/"
  RedirectMatch 301 "^/insights/$" "/notes/"
  RedirectMatch 301 "^/insights/conversion-theme-architecture/$" "/notes/conversion-theme-architecture/"
  RedirectMatch 301 "^/insights/cro-consultant-vs-agency/$" "/notes/cro-consultant-vs-agency/"
  RedirectMatch 301 "^/insights/shopify-cro-mistakes/$" "/notes/shopify-cro-mistakes/"
  RedirectMatch 301 "^/insights/shopify-technical-seo-guide/$" "/notes/shopify-technical-seo-guide/"
  RedirectMatch 301 "^/insights/shopify-traffic-no-sales/$" "/notes/shopify-traffic-no-sales/"
  RedirectMatch 301 "^/case-studies/beauty-headless-migration/$" "/case-studies/"
</IfModule>

# ── Short links · src/data/links.ts · 42 codes ────────────
#    /go/ LinkedIn  ·  /x/ X  ·  /rd/ Reddit  ·  /em/ Email  ·  /gh/ GitHub  ·  /cm/ Community
# ⛔ GENERATED. Add or change a link in src/data/links.ts, then rebuild.
#    A hand-edit here survives until the next `pnpm release` and then
#    disappears with no error.
#
# ⛔ 302, not 301 — these handles are EXPECTED to be re-pointed. A 301
#    is cached hard by browsers and CDNs, so a later re-point reaches
#    some readers and not others, with no way to tell which.
#    ⭐ /*/standard is live proof: it points at /method/ until the
#    standards page exists, then only its `to` changes.
#
# ⚠️ ABOVE THE TRAILING-SLASH RULE, DELIBERATELY. /go/audit has no
#    trailing slash; if the slash rule ran first it would 301 to
#    /go/audit/ and the reader would pay two redirects per click.
#    `/?$` here accepts both forms and resolves in ONE hop.
#
# ⚠️ QSD DISCARDS ANY INBOUND QUERY. A platform that appends its own
#    tracking param must not produce two `?` in the composed URL.
<IfModule mod_rewrite.c>
  RewriteEngine On
  # The CRO audit — the entry offer and the conversion spine’s end.
  RewriteRule "^go/audit/?$" "/shopify-cro-audit/?utm_source=linkedin&utm_medium=social&utm_campaign=cro_audit" [R=302,L,QSD]
  # The standard. ⚠️ Points at /method/ until the standards page is built — re-point `to` only, never the campaign.
  RewriteRule "^go/standard/?$" "/method/?utm_source=linkedin&utm_medium=social&utm_campaign=the_standard" [R=302,L,QSD]
  # The CRO pillar — the whole-funnel diagnosis page.
  RewriteRule "^go/cro/?$" "/shopify-cro/?utm_source=linkedin&utm_medium=social&utm_campaign=shopify_cro" [R=302,L,QSD]
  # Page 17 — crawl and indexation. ⚠️ Gated on [SOW §2.8]’s overlap test; if that merges the page back into page 7, re-point `to`.
  RewriteRule "^go/technical-seo/?$" "/shopify-technical-seo/?utm_source=linkedin&utm_medium=social&utm_campaign=technical_seo" [R=302,L,QSD]
  # Amazon sellers building an owned store. ⚠️ A DIFFERENT AUDIENCE, not a service page — its own campaign so that traffic never merges with the audit’s.
  RewriteRule "^go/amazon/?$" "/amazon-to-shopify/?utm_source=linkedin&utm_medium=social&utm_campaign=catalogue_portability" [R=302,L,QSD]
  # The writing. For a post pointing at the body of work rather than one article.
  RewriteRule "^go/notes/?$" "/notes/?utm_source=linkedin&utm_medium=social&utm_campaign=notes" [R=302,L,QSD]
  # The homepage — for a profile link and any post pointing at the whole site rather than one surface.
