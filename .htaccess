# ── Trailing slashes ───────────────────────────────────────────────
# astro.config.mjs sets `trailingSlash: "always"` and the build emits
# directory-style pages (/about/index.html). This makes Apache agree,
# so /about and /about/ do not become two URLs with the same content.
#
# ⚠️ Two URLs are ALREADY INDEXED without their slash — /contact and
# /case-studies/fitness-technical-seo (3 impressions each, GSC 12mo to
# 2026-10-06). This is the rule that resolves them.
#
# ⚠️ The redirect rules above run FIRST (mod_alias precedes mod_rewrite),
# so an old URL is 301'd to its target before this can touch it.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # ── ONE HOSTNAME ────────────────────────────────────────────────
  # ⚠️ ADDED 2026-10-13. www.growthinn.co served 200 — it did NOT
  # redirect — so the whole site was reachable on two hostnames and
  # every page existed twice. The canonical tag named the apex, but a
  # canonical is a HINT and a 301 is an instruction. Likely the GSC
  # "Duplicate, Google chose different canonical than user" row.
  #
  # Host-generic on purpose: %{HTTP_HOST} is reused rather than the
  # domain hardcoded, so this cannot drift from the real origin.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # ── NO index.html ───────────────────────────────────────────────
  # ⚠️ ADDED 2026-10-13. /index.html served 200 alongside /, so the
  # home page was reachable at a second path too. Any directory
  # index, not just the root: /notes/index.html collapses to /notes/.
  #
  # ⛔ MUST PRECEDE the -f guard below. index.html IS a real file, so
  # the guard would match it first and this rule would never run.
  # %{THE_REQUEST} reads the ORIGINAL request line, so this only
  # fires on what the visitor actually typed — an internal rewrite
  # to index.html is untouched and there is no redirect loop.
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /%1 [R=301,L]

  # Never rewrite a real file or directory.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Add the trailing slash to anything else that lacks one.
  RewriteCond %{REQUEST_URI} !(/$|\.[a-zA-Z0-9]{2,5}$)
  RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

# ── Caching ────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  # Fonts are content-addressed by name; a new face means a new file.
  <FilesMatch "\.(woff2|woff|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>

  # Astro fingerprints everything in /_astro/.
  <FilesMatch "\.(css|js|webp|avif|png|jpg|jpeg|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # ⚠️ HTML MUST REVALIDATE, or a cached page serves stale copy after
  # a deploy with no way for the reader to know.
  <FilesMatch "\.(html|xml|txt|json)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── The 404 ────────────────────────────────────────────────────────
# ⛔ A real 404, not a redirect to /. A blanket redirect to root is read
# as a soft 404 and is worse than a clean one.
ErrorDocument 404 /404.html

# ── Compression ────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
